<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set canon = site.url + "/blog" + page.url %}
  <title>{{ seoTitle or title }}{% if not noSuffix %} · Linkker{% endif %}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ canon }}">
  <meta name="theme-color" content="#fbf8f3">
  <meta name="color-scheme" content="light">
  <meta property="og:type" content="{{ 'article' if hero else 'website' }}">
  <meta property="og:site_name" content="Linkker">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canon }}">
  <meta property="og:image" content="{{ site.url }}{{ ('/blog' + hero) if hero else '/assets/og-image.png' }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="alternate" type="application/rss+xml" title="The Linkker blog" href="/blog/feed.xml">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap">
  <link rel="stylesheet" href="/assets/site.css">
  <link rel="stylesheet" href="/assets/blog.css">
  <script>document.documentElement.classList.add('js')</script>
  <script src="/assets/site.js" defer></script>
</head>
<body class="blog">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/" aria-label="Linkker home"><img src="/assets/logo-tile.svg" alt="" width="36" height="36">Linkker</a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
        <svg class="i-menu" aria-hidden="true"><use href="/assets/icons.svg#i-menu"/></svg>
        <svg class="i-close" aria-hidden="true"><use href="/assets/icons.svg#i-close"/></svg>
      </button>
      <nav id="site-nav" class="nav" aria-label="Main">
        <a href="/#features">Features</a>
        <a href="/#how">How it works</a>
        <a href="/blog/" aria-current="page">Blog</a>
        <a href="/support">Support</a>
        <a class="btn btn--primary btn--sm" href="/#download">Get the app</a>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-top">
        <div>
          <a class="brand" href="/"><img src="/assets/logo-tile.svg" alt="" width="36" height="36" loading="lazy">Linkker</a>
          <p>Save links from anywhere, find them in seconds, and keep the private ones private.</p>
        </div>
        <div class="footer-col">
          <h2>Product</h2>
          <ul>
            <li><a href="/#features">Features</a></li>
            <li><a href="/#download">Download</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/#faq">FAQ</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h2>Help</h2>
          <ul>
            <li><a href="/support">Support</a></li>
            <li><a href="mailto:nikhilbiju6449@gmail.com">Email us</a></li>
            <li><a href="/delete-account">Delete account</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h2>Legal</h2>
          <ul>
            <li><a href="/privacy-policy">Privacy Policy</a></li>
            <li><a href="/terms-of-service">Terms of Service</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© <span data-year>2026</span> Linkker · Made by Nikhil Biju</span>
        <a href="/blog/feed.xml">RSS</a>
      </div>
    </div>
  </footer>
</body>
</html>
